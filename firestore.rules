rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated and verified as admin
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.firebase.sign_in_provider != 'anonymous' &&
         'email' in request.auth.token &&
         request.auth.token.email != null) ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin')
      );
    }

    // ============================================
    // NEWSORA COLLECTIONS
    // Permissive read & write for verified news publishing
    // ============================================

    // 1. Articles Collection
    match /articles/{articleId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Categories Collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // 3. Breaking News Collection
    match /breakingNews/{breakingId} {
      allow read, write: if true;
    }

    // 4. Authors Collection
    match /authors/{authorId} {
      allow read, write: if true;
    }

    // 5. Site Settings Collection
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }

    // 6. Admin Users Allowlist / Profiles
    match /adminUsers/{userId} {
      allow read, write: if true;
    }

    // 7. Analytics & Article Views
    match /analytics/{docId} {
      allow read, write: if true;
    }

    // ============================================
    // PRESERVED COMPATIBILITY COLLECTIONS
    // ============================================
    match /pins/{pinId} {
      allow read: if true;
      allow create: if request.resource.data.latitude is number &&
                       request.resource.data.longitude is number;
      allow update: if true;
      allow delete: if isAdmin();

      match /reporters/{userId} { allow read, write: if true; }
      match /votes/{userId} { allow read, write: if true; }
      match /flags/{userId} { allow read, write: if true; }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    match /limits/{uid} { allow read, write: if true; }
    match /ipLimits/{ipHash} { allow read, write: if true; }
    match /rate_limits/{docId} { allow read, write: if true; }

    match /stats/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /savesahyadri_supporters/{supporterId} {
      allow read: if true;
      allow create: if request.resource.data.displayName is string &&
                       request.resource.data.displayName.size() >= 2;
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /sahyadri_supporters/{supporterId} {
      allow read: if true;
      allow create: if request.resource.data.displayName is string &&
                       request.resource.data.displayName.size() >= 2;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
